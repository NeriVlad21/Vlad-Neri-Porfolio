        <div class="features-grid">
            <ul class="check-list">
                <li><i class="fa-regular fa-circle-check"></i> Admin Dashboard</li>
                <li><i class="fa-regular fa-circle-check"></i> Rental Tracking</li>
                <li><i class="fa-regular fa-circle-check"></i> Inventory Management</li>
                <li><i class="fa-regular fa-circle-check"></i> Employee/Customer DB</li>
