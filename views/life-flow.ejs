<%- include('partials/header') %>

<div class="mobile-container page-layout">
    <a href="/projects" class="back-link">
        <i class="fa-solid fa-chevron-left"></i> Back to Projects
    </a>

    <div class="project-hero gradient-red">
        <div class="hero-icon">
            <i class="fa-solid fa-heart-pulse"></i>
        </div>
        <div class="hero-text">
            <h1>Life Flow</h1>
            <p>Blood Donation Website to facilitate donor registration and helping those in need.</p>
        </div>
    </div>

    <div class="project-meta-grid">
        <div class="meta-column">
